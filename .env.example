# ThreadCraft AI — environment configuration
#
# By default the app uses the offline MOCK AI provider (no key required).
# To use a real LLM instead, set NEXT_PUBLIC_AGENT_PROVIDER=remote and configure
# the server-side credentials below. The API key NEVER reaches the browser.

# Switch the client to call the real /api/agent route ("mock" | "remote").
NEXT_PUBLIC_AGENT_PROVIDER=mock

# --- Server-side LLM credentials (only used when provider=remote) ---
# Works with any OpenAI-compatible chat-completions API:
#   OpenAI:      AGENT_BASE_URL=https://api.openai.com/v1            AGENT_MODEL=gpt-4o-mini
#   OpenRouter:  AGENT_BASE_URL=https://openrouter.ai/api/v1         AGENT_MODEL=openai/gpt-4o-mini
#   Qwen (CN):   AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1          AGENT_MODEL=qwen-plus
#   Qwen (intl): AGENT_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1     AGENT_MODEL=qwen-plus
#   DeepSeek:    AGENT_BASE_URL=https://api.deepseek.com/v1            AGENT_MODEL=deepseek-chat
#   Ollama:      AGENT_BASE_URL=http://localhost:11434/v1            AGENT_MODEL=llama3.1

# AGENT_API_KEY=sk-...
# AGENT_BASE_URL=https://api.openai.com/v1
# AGENT_MODEL=gpt-4o-mini


# =====================================================================
# IMAGE GENERATION (Phase 4)
# =====================================================================
# By default a MOCK image provider renders deterministic SVG "artwork" with no
# key. To use a real image model, set NEXT_PUBLIC_IMAGE_PROVIDER=remote and
# configure the server-side credentials below.

NEXT_PUBLIC_IMAGE_PROVIDER=mock

# --- Server-side image credentials (only used when provider=remote) ---
# OpenAI-compatible images API:
#   OpenAI:  IMAGE_BASE_URL=https://api.openai.com/v1   IMAGE_MODEL=gpt-image-1
# IMAGE_API_KEY=sk-...
# IMAGE_BASE_URL=https://api.openai.com/v1
# IMAGE_MODEL=gpt-image-1
